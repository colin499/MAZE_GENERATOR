{
  "name": "maze-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Generator and editor for extremely difficult 3D ball mazes, with parametric export to Fusion 360.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.core.json --noEmit",
    "lint": "eslint src test",
    "export": "tsx src/cli/export.ts",
    "check": "npm run typecheck && npm run lint && npm test",
    "app": "vite build && mkdir -p app && cp dist/index.html app/MazeBuilder.html",
    "smoke:file": "node scripts/smoke-file.mjs"
  },
  "dependencies": {
    "@preact/signals": "^2.0.0",
    "preact": "^10.25.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@preact/preset-vite": "^2.9.0",
    "@types/node": "^22.10.0",
    "@types/three": "^0.170.0",
    "eslint": "^9.17.0",
    "fast-check": "^3.23.0",
    "puppeteer-core": "^23.11.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^2.1.0"
  }
}
